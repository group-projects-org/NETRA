PORT=5001 # Express server port
FRONTEND_URL=http://localhost:5173
FASTAPI_API_URL=http://localhost:8000

# Database connection details, Default: Local MySQL server, For Aiven, replace these values with the connection credentials provided in Aiven Console.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<Enter password here>
DB_NAME=netra_db
# Set to false for local MySQL connections, Set to true when connecting to hosted MySQL services such as Aiven.
DB_SSL=false
# Path to the MySQL CA certificate, required only when DB_SSL=true.
DB_SSL_CA=./certs/ca.pem